# okna AI Advisor proxy — environment
# Copy to .env and fill in. NEVER commit the real .env.

# Required: your Anthropic API key (kept server-side; clients never see it)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model + limits
ADVISOR_MODEL=claude-opus-4-8
ADVISOR_MAX_TOKENS=1024

# Optional: lock CORS to your app origins (comma-separated). Default "*".
# Web:  https://your-okna-domain.example
# APK:  the Android WebView origin (https://localhost)
ALLOWED_ORIGIN=*

# Optional: shared secret. If set, the app must send it as the x-app-token
# header (build the app with NEXT_PUBLIC_ADVISOR_APP_TOKEN set to the same value).
ADVISOR_APP_TOKEN=

# Optional
PORT=8787
# ANTHROPIC_BASE_URL=https://api.anthropic.com
